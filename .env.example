# Docker 部署配置（请复制本文件为 .env）
# ARTEX_TAG 是 docker-compose 拉取的上游官方镜像 autumn27/artex 的 tag。
# 该镜像不包含本 fork 的改动（管理端口仅绑定本机、自更新发布源指向本 fork、可选韩语界面等）。
# 如需这些改动，请参照 README "从源码编译单一二进制" 一节自行构建。
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（填其中一个或两个都填。也可以留空，之后在 UI 中设置）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
